{% doc %}
  @prompt
    Create a prominent announcement banner where I can inform customers about crucial updates on the store
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-banner-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    text-align: {{ block.settings.text_alignment }};
    position: relative;
    overflow: hidden;
  }

  .ai-announcement-banner-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.text_alignment }};
    gap: 12px;
    position: relative;
  }

  .ai-announcement-banner-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-announcement-banner-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .ai-announcement-banner-content-{{ ai_gen_id }} {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-announcement-banner-message-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    line-height: 1.4;
    margin: 0;
  }

  .ai-announcement-banner-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
    font-size: {{ block.settings.link_font_size }}px;
    transition: opacity 0.2s ease;
  }

  .ai-announcement-banner-link-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-announcement-banner-close-{{ ai_gen_id }} {
    flex-shrink: 0;
    background: none;
    border: none;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .ai-announcement-banner-close-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-announcement-banner-close-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
  }

  .ai-announcement-banner-{{ ai_gen_id }}.hidden {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-banner-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.8 }}px {{ block.settings.padding_horizontal | times: 0.8 }}px;
    }

    .ai-announcement-banner-container-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: center;
      justify-content: center;
    }

    .ai-announcement-banner-message-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }

    .ai-announcement-banner-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.link_font_size | times: 0.9 }}px;
    }

    .ai-announcement-banner-close-{{ ai_gen_id }} {
      position: absolute;
      top: 8px;
      right: 8px;
    }
  }
{% endstyle %}

<announcement-banner-{{ ai_gen_id }}
  class="ai-announcement-banner-{{ ai_gen_id }}"
  data-banner-id="{{ block.id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-announcement-banner-container-{{ ai_gen_id }}">
    {% if block.settings.show_icon %}
      <div class="ai-announcement-banner-icon-{{ ai_gen_id }}">
        {% if block.settings.icon_type == 'megaphone' %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 11 18-5v12L3 14v-3z"></path>
            <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path>
          </svg>
        {% elsif block.settings.icon_type == 'bell' %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
          </svg>
        {% elsif block.settings.icon_type == 'info' %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
        {% elsif block.settings.icon_type == 'alert' %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        {% elsif block.settings.icon_type == 'star' %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-announcement-banner-content-{{ ai_gen_id }}">
      {% if block.settings.message != blank %}
        <div class="ai-announcement-banner-message-{{ ai_gen_id }}">
          {{ block.settings.message }}
        </div>
      {% endif %}

      {% if block.settings.link_text != blank and block.settings.link_url != blank %}
        <a href="{{ block.settings.link_url }}" class="ai-announcement-banner-link-{{ ai_gen_id }}">
          {{ block.settings.link_text }}
        </a>
      {% endif %}
    </div>

    {% if block.settings.show_close_button %}
      <button
        class="ai-announcement-banner-close-{{ ai_gen_id }}"
        aria-label="Close announcement"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    {% endif %}
  </div>
</announcement-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.bannerId = this.dataset.bannerId;
        this.storageKey = 'announcement-banner-closed-' + this.bannerId;
      }

      connectedCallback() {
        if (this.isClosed()) {
          this.classList.add('hidden');
          return;
        }

        const closeButton = this.querySelector('.ai-announcement-banner-close-{{ ai_gen_id }}');
        if (closeButton) {
          closeButton.addEventListener('click', () => this.closeBanner());
        }
      }

      isClosed() {
        try {
          return localStorage.getItem(this.storageKey) === 'true';
        } catch (e) {
          return false;
        }
      }

      closeBanner() {
        this.classList.add('hidden');
        try {
          localStorage.setItem(this.storageKey, 'true');
        } catch (e) {
          console.warn('Could not save banner state');
        }
      }
    }

    customElements.define('announcement-banner-{{ ai_gen_id }}', AnnouncementBanner{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Announcement banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "Message",
      "default": "<p>Important: Free shipping on all orders over $50!</p>"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "select",
      "id": "icon_type",
      "label": "Icon type",
      "options": [
        {
          "value": "megaphone",
          "label": "Megaphone"
        },
        {
          "value": "bell",
          "label": "Bell"
        },
        {
          "value": "info",
          "label": "Info"
        },
        {
          "value": "alert",
          "label": "Alert"
        },
        {
          "value": "star",
          "label": "Star"
        }
      ],
      "default": "megaphone"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 24
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1e5f5c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#f5eedd"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Message font size",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Message font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "link_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Link font size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 800,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Container width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 24
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "show_close_button",
      "label": "Show close button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Announcement banner"
    }
  ]
}
{% endschema %}
